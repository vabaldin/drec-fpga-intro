--- /dev/null
+++ b/hw/arm/mul-dev.c
@@ -0,0 +1,92 @@
+#include "qemu/osdep.h"
+#include "hw/sysbus.h"
+#include "migration/vmstate.h"
+
+#define TYPE_MUL_DEV "mul-dev"
+OBJECT_DECLARE_SIMPLE_TYPE(MulDev, MUL_DEV)
+
+struct MulDev {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    uint32_t a;
+    uint32_t b;
+};
+
+static uint64_t mul_read(void *opaque, hwaddr addr, unsigned size)
+{
+    MulDev *s = opaque;
+
+    switch (addr) {
+    case 0: return s->a;
+    case 4: return s->b;
+    case 8: return (uint32_t)(s->a * s->b);
+    default: return 0;
+    }
+}
+
+static void mul_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    MulDev *s = opaque;
+
+    switch (addr) {
+    case 0: s->a = value; break;
+    case 4: s->b = value; break;
+    }
+}
+
+static const MemoryRegionOps mul_ops = {
+    .read = mul_read,
+    .write = mul_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void mul_init(Object *obj)
+{
+    MulDev *s = MUL_DEV(obj);
+
+    memory_region_init_io(&s->mmio, obj, &mul_ops, s, TYPE_MUL_DEV, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mmio);
+}
+
+static void mul_reset(DeviceState *dev)
+{
+    MulDev *s = MUL_DEV(dev);
+
+    s->a = 0;
+    s->b = 0;
+}
+
+static const VMStateDescription mul_vmstate = {
+    .name = TYPE_MUL_DEV,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(a, MulDev),
+        VMSTATE_UINT32(b, MulDev),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void mul_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, mul_reset);
+    dc->vmsd = &mul_vmstate;
+}
+
+static const TypeInfo mul_info = {
+    .name = TYPE_MUL_DEV,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(MulDev),
+    .instance_init = mul_init,
+    .class_init = mul_class_init,
+};
+
+static void mul_register(void)
+{
+    type_register_static(&mul_info);
+}
+type_init(mul_register)
