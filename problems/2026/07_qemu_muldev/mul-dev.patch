+static void create_mul_dev(VirtMachineState *vms)
+{
+    const MemMapEntry *map = &vms->memmap[VIRT_MUL_DEV];
+    g_autofree char *node = g_strdup_printf("/mul-dev@%" PRIx64, map->base);
+    void *fdt = MACHINE(vms)->fdt;
+
+    sysbus_create_simple("mul-dev", map->base, NULL);
+    qemu_fdt_add_subnode(fdt, node);
+    qemu_fdt_setprop_string(fdt, node, "compatible", "drec,mul-dev");
+    qemu_fdt_setprop_sized_cells(fdt, node, "reg", 2, map->base, 2, map->size);
+}
